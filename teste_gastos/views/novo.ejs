<!DOCTYPE html>
<html>
<head>

    <title>Novo Gasto</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body class="container mt-5">

    <h1>Novo Gasto</h1>

    <form action="/gastos/salvar" method="POST">

        <div class="mb-3">

            <label>Descrição</label>

            <input
                type="text"
                name="descricao"
                class="form-control"
            >

        </div>

        <div class="mb-3">

            <label>Valor</label>

            <input
                type="number"
                name="valor"
                class="form-control"
            >

        </div>

        <button class="btn btn-primary">
            Salvar
        </button>

    </form>

</body>
</html>