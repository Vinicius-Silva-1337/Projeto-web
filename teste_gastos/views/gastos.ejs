<!DOCTYPE html>
<html>
<head>

    <title>Gastos</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body class="container mt-5">

    <h1>Sistema de Gastos</h1>

    <a href="/gastos/novo" class="btn btn-success mb-3">
        Novo Gasto
    </a>

    <table class="table table-bordered">

        <tr>
            <th>ID</th>
            <th>Descrição</th>
            <th>Valor</th>
            <th>Ações</th>
        </tr>

        <% gastos.forEach(gasto => { %>

            <tr>
                <td><%= gasto.id %></td>
                <td><%= gasto.descricao %></td>
                <td>R$ <%= gasto.valor %></td>

                <td>
                    <a href="/gastos/editar/<%= gasto.id %>" class="btn btn-warning btn-sm">     
                        Editar</a>
                    

                    <a href="/gastos/excluir/<%= gasto.id %>" class="btn btn-danger btn-sm">
                        Excluir
                    </a>
                </td>
            </tr>
        <% }) %>
    </table>

</body>
</html>