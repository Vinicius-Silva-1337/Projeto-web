<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Sistema RH</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <% if (usuario) { %>
    <nav class="navbar navbar-expand-lg bg-body-tertiary border-bottom sticky-top">
      <div class="container-fluid">
        <a class="navbar-brand fw-semibold" href="/">Sistema RH</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarRH">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarRH">
          <ul class="navbar-nav me-auto mb-2 mb-lg-0">
            <li class="nav-item"><a class="nav-link" href="/departamentos">Departamentos</a></li>
            <li class="nav-item"><a class="nav-link" href="/cargos">Cargos</a></li>
            <li class="nav-item"><a class="nav-link" href="/funcionarios">Funcionarios</a></li>
            <li class="nav-item"><a class="nav-link" href="/folha">Folha</a></li>
            <li class="nav-item"><a class="nav-link" href="/ferias">Ferias</a></li>
            <li class="nav-item"><a class="nav-link" href="/ponto">Ponto</a></li>
            <li class="nav-item"><a class="nav-link" href="/usuarios">Usuarios</a></li>
          </ul>
          <div class="d-flex align-items-center gap-3">
            <span class="small text-secondary"><%= usuario.nome %> - <%= usuario.perfil %></span>
            <form method="post" action="/logout">
              <button class="btn btn-outline-danger btn-sm" type="submit">Sair</button>
            </form>
          </div>
        </div>
      </div>
    </nav>
  <% } %>
  <main class="<%= usuario ? 'container-fluid py-4' : '' %>">
    <% if (alert) { %>
      <div class="container-fluid px-0">
        <div class="alert alert-<%= alert.type %> alert-dismissible fade show" role="alert">
          <%= alert.message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      </div>
    <% } %>
